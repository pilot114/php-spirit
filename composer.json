{
    "require": {
        "php": ">=8.4",
        "knplabs/packagist-api": "^3.0",
        "symfony/finder": "^8.1",
        "knplabs/github-api": "^3.16",
        "guzzlehttp/guzzle": "^8.3",
        "m4tthumphrey/php-gitlab-api": "^12.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1",
        "phpstan/phpstan": "^2.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.7",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "files": [
            "./src/functions.php"
        ]
    },
    "scripts": {
        "test": "@php -r \"echo 'тестов нет', PHP_EOL;\"",
        "check": [
            "phpstan analyse --memory-limit=1G --no-progress",
            "rector process --dry-run",
            "phpcs"
        ],
        "fix": [
            "rector process",
            "phpcbf"
        ]
    }
}
